    <string name="monero_rescan_hint">Ten portfel skanuje od początku łańcucha, co trwa o wiele dłużej, niż musi, jeśli powstał niedawno.</string>
    <string name="monero_skip_ahead">Przeskocz dalej</string>
    <string name="monero_trust_plaintext">Do tego łączysz się bez szyfrowania, więc każdy w sieci po drodze może to samo: przeczytać albo zmienić.</string>
