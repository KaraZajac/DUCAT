    <string name="feed_delete_post">पोस्ट हटाएँ</string>
    <string name="feed_delete_post_body">यह पोस्ट हटाएँ? यह अगले संस्करण में आपके फ़ीड से हट जाएगी; जिसने पुराना संस्करण रखा है, उसके पास रहेगी।</string>
    <string name="feed_saved_to_files">%1$s फ़ाइलें पृष्ठ पर है।</string>
    <string name="feed_no_home_yet">अभी कुछ पोस्ट नहीं हुआ। आपकी पहली पोस्ट आपका घर नेटवर्क पर रखती है।</string>
