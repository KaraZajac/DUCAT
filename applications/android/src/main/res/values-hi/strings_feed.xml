    <string name="section_feed">फ़ीड</string>
    <string name="feed_post">पोस्ट</string>
    <string name="feed_post_hint">क्या हो रहा है? शब्द, एक तस्वीर, एक फ़ाइल।</string>
    <string name="feed_post_note">तस्वीरें थंबनेल और पूरे आकार की साझा प्रति के रूप में जाती हैं; फ़ाइलें साझा प्रति के रूप में। जो आपको रखते हैं, वे अगली बार देखने पर इसे देखेंगे।</string>
    <string name="feed_add_photos">फ़ोटो जोड़ें</string>
    <string name="feed_add_files">फ़ाइलें जोड़ें</string>
    <string name="feed_posting">लगाया जा रहा है…</string>
    <string name="feed_posted">पोस्ट हो गया।</string>
    <string name="feed_empty">अभी यहाँ कुछ नहीं है। किसी संपर्क को दिल दें ताकि उनका घर रखें, या खुद कुछ पोस्ट करें।</string>
