<!--
  The splash mark: the same ducat as the launcher icon, drawn so it can draw
  itself.

  Identical geometry to ic_ducat_coin — this is that coin, not a second one —
  but every path is named, because an AnimatedVectorDrawable addresses its
  targets by name and an anonymous path cannot be animated. Kept separate
  rather than adding names to the launcher icon, which is loaded by the system
  at boot on a path where nothing should be paying for animation machinery it
  will never run.

  Strokes rather than fills, again for the same reason as the launcher mark:
  a stroke has a length, and a length can be drawn on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="coin">
        <!-- Coin edge -->
        <path
            android:name="edge"
            android:strokeColor="#CBA6F7"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:trimPathEnd="0"
            android:pathData="M54,26 A28,28 0 1,1 53.9,26" />

        <!-- Inner ring: the milled rim of a struck coin -->
        <path
            android:name="rim"
            android:strokeColor="#CBA6F7"
            android:strokeWidth="2"
            android:fillColor="#00000000"
            android:strokeAlpha="0.55"
            android:trimPathEnd="0"
            android:pathData="M54,33 A21,21 0 1,1 53.9,33" />

        <!-- D, struck into the face: stem and bowl -->
        <path
            android:name="stem"
            android:strokeColor="#CBA6F7"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:trimPathEnd="0"
            android:pathData="M45,42 L45,66" />
        <path
            android:name="bowl"
            android:strokeColor="#CBA6F7"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:trimPathEnd="0"
            android:pathData="M45,42 L52,42 C61,42 66,47 66,54 C66,61 61,66 52,66 L45,66" />
    </group>
</vector>
