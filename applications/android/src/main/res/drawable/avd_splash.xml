<!--
  The cat arrives, and the ring closes around it.

  The ring draws from twelve o'clock all the way round while the cat settles
  up to size — so the last thing that happens is the circle meeting itself,
  which is a better ending than a shape simply being present.

  **Under a second, all of it.** The system splash is held only until the first
  frame is ready (see Theme.Ducat.Splash), and an animation longer than the
  wait is one nobody sees the end of — or worse, one the app waits for, which
  turns a splash into a delay.

  The cat settles rather than bounces. It is a coin-holding cat, not a spring.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_cat">

    <target android:name="ring">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="720"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="cat">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.34"
                    android:valueTo="0.52"
                    android:duration="620"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.34"
                    android:valueTo="0.52"
                    android:duration="620"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
