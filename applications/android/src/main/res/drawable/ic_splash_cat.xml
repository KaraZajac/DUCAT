<!--
  The splash mark: the cat, and the ring that draws itself around it.

  The same silhouette as ic_cat_mono, at the size the system splash wants,
  with two things it needs that the icon does not: names, because an
  AnimatedVectorDrawable addresses its targets by name and an anonymous path
  cannot be animated — and a ring, which exists only to be drawn on. A filled
  shape has no length to trim; a stroked circle has, and that is what makes
  the mark arrive rather than simply appear.

  Kept apart from the launcher icon, which the system loads at boot and should
  not be paying for animation machinery it will never run.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- The ring, drawn from the top and round. Starts at zero length.

         Radius 36, not 42: the system splash shows roughly the middle
         two-thirds of the icon and clips the rest, and a ring drawn out at the
         edge is a ring nobody sees. -->
    <path
        android:name="ring"
        android:strokeColor="#CBA6F7"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:trimPathEnd="0"
        android:pathData="M54,18 A36,36 0 1,1 53.9,18" />

    <group
        android:name="cat"
        android:pivotX="47.5" android:pivotY="50.5"
        android:scaleX="0.52" android:scaleY="0.52"
        android:translateX="6.5" android:translateY="3.5">
        <path
            android:name="body"
            android:fillColor="#CBA6F7"
            android:fillType="evenOdd"
            android:pathData="M35,32 L30,9 L51,21 C52,20 59,20 60,21 L81,9 L76,32 C80,36 82,41 82,46 C82,50 80,54 77,57 C84,61 88,69 88,78 C88,86 83,92 75,92 L37,92 C29,92 24,86 24,78 C24,70 27,63 32,58 C29,55 27,51 27,46 C27,41 30,36 35,32 Z M16,27 C21,27 24,32 24,38 L24,52 C24,57 20,60 16,60 C11,60 8,56 8,51 L8,37 C8,31 11,27 16,27 Z M56,62 C64,62 71,69 71,77 C71,85 64,92 56,92 C48,92 41,85 41,77 C41,69 48,62 56,62 Z" />
    </group>
</vector>
