<resources>
    <string name="section_sites">المواقع</string>
    <string name="sites_intro">صفحات تسافر كالمطبوعات: تُجلب كاملة وتُقرأ دون اتصال ويعكسها القراء باختيارهم. لا شيء في الصفحة يراك.</string>
    <string name="sites_empty_title">لا مواقع بعد</string>
    <string name="sites_empty_body">موقع ducat غرفة مختومة — كل صورة ونمط يسافران في الحزمة، لا نصوص برمجية، وروابط ducat: وحدها تعمل. ألصق عنوانًا لحفظ موقع.</string>
    <string name="sites_add">إضافة موقع</string>
    <string name="sites_add_confirm">إضافة</string>
    <string name="sites_add_link_title">إضافة هذا الموقع؟</string>
    <string name="sites_add_link_body">وصل هذا العنوان عبر رابط. الإضافة تحفظه على رفّك؛ لا يُجلب شيء حتى تفتحه.</string>
    <string name="sites_uri_label">عنوان ducat:site/…</string>
    <string name="sites_bad_uri">هذا ليس عنوان ducat:site/.</string>
    <string name="sites_not_fetched">لم يُجلب بعد</string>
    <string name="sites_update_waiting">يوجد تحديث — سيفتح محدثًا</string>
    <string name="sites_offline_ready">جاهز دون اتصال</string>
    <string name="sites_open">فتح</string>
    <string name="sites_keep_alive">أبقِ هذا الموقع حيًا للآخرين</string>
    <string name="sites_remove">إزالة</string>
    <string name="sites_fetching_waiting">جارٍ الجلب — في انتظار من يقدّمه…</string>
    <string name="sites_drop_mine_title">حذف صفحتك؟</string>
    <string name="sites_drop_mine_body">«%1$s» صفحتك. حذفها هنا يتخلّص من المفتاح الوحيد القادر على تغييرها — يظل العنوان يقدّم آخر نسخة لمن يشاركها، ولا شيء يستطيع تحديثها بعد ذلك.</string>
    <string name="sites_drop_mine_go">احذفها</string>
