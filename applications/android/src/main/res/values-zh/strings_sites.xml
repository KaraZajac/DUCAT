<resources>
    <string name="section_sites">站点</string>
    <string name="sites_intro">像出版物一样旅行的页面：整体取回、离线可读、由自愿的读者镜像。页面上的任何东西都看不见你。</string>
    <string name="sites_empty_title">还没有站点</string>
    <string name="sites_empty_body">ducat 站点是一间密封的房间——所有图片与样式都随包而来，脚本关闭，只有 ducat: 链接可用。粘贴地址即可保存。</string>
    <string name="sites_add">添加站点</string>
    <string name="sites_add_confirm">添加</string>
    <string name="sites_add_link_title">添加此站点？</string>
    <string name="sites_add_link_body">这个地址来自一个链接。添加后会保存到你的书架；在你打开之前不会获取任何内容。</string>
    <string name="sites_uri_label">ducat:site/… 地址</string>
    <string name="sites_bad_uri">这不是 ducat:site/ 地址。</string>
    <string name="sites_not_fetched">尚未获取</string>
    <string name="sites_update_waiting">有更新——将以新版打开</string>
    <string name="sites_offline_ready">可离线阅读</string>
    <string name="sites_open">打开</string>
    <string name="sites_keep_alive">为他人保持此站点存活</string>
    <string name="sites_remove">移除</string>
    <string name="sites_fetching_waiting">正在获取 — 等待有人提供…</string>
    <string name="sites_drop_mine_title">删除你的页面？</string>
    <string name="sites_drop_mine_body">“%1$s”是你的。在这里删除会丢掉唯一能改动它的密钥——地址仍会把最后一版提供给还在分享的人，而此后没有任何东西能更新它。</string>
    <string name="sites_drop_mine_go">删除</string>
