    <string name="drawer_forget_body">这会删除该联系人以及来自对方的所有消息，且无法恢复。要再联系上对方，需要一张新名片。</string>
    <string name="drawer_forget_confirm">忘掉</string>

    <!-- Operating modes -->
    <string name="modes_intro">选定这台设备当下的角色。选定的模式会接管整个应用，直到你回到这里选回「个人」。</string>
    <string name="mode_personal">个人</string>
    <string name="mode_personal_desc">你的钱包、聊天和记录。默认模式。</string>
    <string name="mode_pos">收银台</string>
    <string name="mode_pos_desc">一台收银机：逐项录入或直接输入总额，出示一个码 — 账单和收据都走它打开的那段对话。</string>
    <string name="mode_bartab">酒吧挂账</string>
