    <string name="drawer_persona_title">你的身份</string>
    <string name="drawer_persona_body">为你的名片签名的密钥。没有人能靠它找到你 — 拿到名片的人用它来核验那张名片。</string>

    <!-- Being paid -->
    <string name="drawer_being_paid_title">收款</string>
