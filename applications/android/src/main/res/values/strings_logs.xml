<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Header counts -->
    <plurals name="logs_line_count">
        <item quantity="one">%1$d line</item>
        <item quantity="other">%1$d lines</item>
    </plurals>
    <string name="logs_warn_count">%1$d warn</string>
    <string name="logs_error_count">%1$d error</string>

    <!-- Toolbar actions -->
    <string name="logs_copy_all">Copy all</string>
    <string name="logs_share">Share</string>
    <string name="logs_send_logs">Send logs</string>
    <string name="logs_clear">Clear</string>
    <string name="logs_copied">Copied. Keys and message text are never in here.</string>

    <!-- Level filter chips -->
    <string name="logs_filter_all">All</string>
    <string name="logs_filter_info">Info</string>
    <string name="logs_filter_warn">Warn</string>
    <string name="logs_filter_error">Error</string>

    <string name="logs_empty">Nothing logged yet. Activity appears here as the app syncs, sends and receives.</string>
</resources>
