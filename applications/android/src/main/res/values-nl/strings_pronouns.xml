<!-- Pronoun labels, one per wire code (§16.9: 1 she/her, 2 she/they, 3 he/him,
     4 he/they, 5 they/them, 6 any). The codes are the protocol's (core's
     Pronouns enum, via pronounOptions()); these labels are presentation and
     follow the app language. Order is the code order — never reorder. -->
<resources>
    <string-array name="pronoun_labels">
        <item>zij/haar</item>
        <item>zij/die</item>
        <item>hij/hem</item>
        <item>hij/die</item>
        <item>die/hen</item>
        <item>alle</item>
    </string-array>
</resources>
