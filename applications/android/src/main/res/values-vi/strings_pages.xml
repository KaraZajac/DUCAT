    <string name="pages_none_body">Trang là một site nhỏ tại địa chỉ mãi mãi là của bạn. Viết một trang, ai có địa chỉ đều đọc được.</string>
    <string name="pages_open_room">Viết một trang</string>
    <string name="pages_address_hint">Bất cứ ai có địa chỉ này đều đọc được trang của bạn.</string>
    <string name="pages_serving_title">Được phục vụ từ máy này</string>
    <string name="pages_serving_body">Trang sống ở nơi có người phục vụ nó. Cho tới khi một người đọc chọn giữ nó sống, người đó là máy này — đóng DUCAT và trang im lặng cho tới khi bạn mở lại.</string>
