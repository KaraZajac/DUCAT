    <string name="mode_pages">Сторінки</string>
    <string name="mode_pages_desc">Розмістіть сторінку в мережі за адресою, що належить вам. Читається офлайн, дзеркалиться охочими.</string>
    <string name="pages_tab_address">Адреса</string>
