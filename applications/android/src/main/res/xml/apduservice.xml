<?xml version="1.0" encoding="utf-8"?>
<!--
  §18.7. The AID is 0xF0 + "DUCAT" = F0445543 4154.

  Android requires AIDs here as an even-length hex string with no separators.
  This value is immutable: iOS readers declare selectable AIDs at build time, so
  a change is a simultaneous update of every client that exists.

  requireDeviceUnlock is true (A3): unlocked, not merely awake. Android routes
  the AID to this service whenever it may, and with false a phone in a pocket
  handed its standing profile card to any reader brought near it — the name,
  the avatar and whatever reach-me identifiers a profile handshake admits, to
  somebody who never had to ask. A tap is a deliberate act everywhere else in
  this app, and it is one here now.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_service_description"
    android:requireDeviceUnlock="true">
    <aid-group
        android:description="@string/nfc_aid_group_description"
        android:category="other">
        <aid-filter android:name="F04455434154" />
    </aid-group>
</host-apdu-service>
