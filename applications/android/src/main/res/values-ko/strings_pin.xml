<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pin_set_title">PIN 정하기</string>
    <string name="pin_set_body">이 휴대폰에서 돈이 나가기 전에 매번 묻습니다. 다른 데서는 쓰지 않으니 계산대에서 칠 수 있는 것으로 정하세요.</string>
    <string name="pin_ask_title">PIN 입력</string>
    <string name="pin_ask_body">곧 이 휴대폰에서 돈이 나갑니다.</string>
    <string name="pin_label">PIN</string>
    <string name="pin_again">다시 입력</string>
    <string name="pin_save">PIN 저장</string>
    <string name="pin_confirm">승인</string>
    <string name="pin_cancel">취소</string>
    <string name="pin_no_reset">앱 안에서 재설정할 방법은 없습니다 — 재설정할 수 있는 무엇이든 곧 우회로가 되기 때문입니다. 잊으셨다면 백업에서 이 지갑을 복원하세요.</string>
    <string name="pin_locked">너무 여러 번 틀렸습니다. %1$s 동안 아무것도 받지 않습니다.</string>
    <string name="pin_gone">이 기기에는 PIN이 없습니다. 보내기 전에 정하세요.</string>
    <plurals name="pin_wrong">
        <item quantity="other">PIN이 아닙니다. 대기까지 %1$d번 남았습니다.</item>
    </plurals>
    <!-- The phone's own lock, offered instead of typing this again -->
    <string name="pin_use_device_lock">휴대폰 잠금 해제 사용</string>
    <string name="pin_device_title">승인하려면 잠금 해제</string>
    <string name="pin_device_subtitle">이 결제가 나가기 전에 본인인지 확인합니다.</string>
</resources>
