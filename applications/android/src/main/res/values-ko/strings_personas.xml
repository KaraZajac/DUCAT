<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="personas_title">페르소나</string>
    <string name="personas_body">이 전화가 누구인지예요. 페르소나마다 키와 연락처가 따로예요 — 가게는 친구들을 절대 알 수 없고, 친구들은 가게를 볼 수 없어요. 새 관계는 지금 쓰고 있는 페르소나로 들어와요.</string>
    <string name="personas_primary">개인</string>
    <string name="personas_worn">착용 중</string>
    <string name="personas_add">페르소나 추가</string>
    <string name="personas_name_label">이름</string>
    <string name="personas_name_support">이런 나를 부르는 이름 — 가게, 마켓, 둘러보기.</string>
    <string name="personas_cap">최대 4개예요. 칸막이는 한 손에 꼽힐 때만 의미가 있어요.</string>
    <string name="personas_no_delete">페르소나는 삭제할 수 없어요 — 그 연락처들은 그 키에만 응답해요. 그만 쓰면 조용해질 뿐이에요.</string>
    <string name="personas_save">저장</string>
    <string name="personas_cancel">취소</string>
    <string name="personas_mode_answers">%1$s(으)로 응답</string>
    <string name="personas_mode_answers_worn">현재 착용한 페르소나로 응답</string>
    <string name="personas_contacts_scope">%1$s의 연락처 — 나머지는 메뉴에서 페르소나를 바꿔 확인.</string>
</resources>
