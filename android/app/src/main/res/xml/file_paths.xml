<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the backups directory is shared, and only through a content URI granted
  per-share. A backup is a spending credential (§4.3.4) — anyone with the file
  and the passphrase becomes the user completely — so it is handed to one chosen
  app at a time rather than left anywhere readable.
-->
<paths>
    <files-path name="backups" path="backups/" />
    <!-- The camera app writes its full frame here before the resize-and-seal
         path picks it up; overwritten by the next shot, never kept. -->
    <cache-path name="camera" path="camera/" />
    <!-- Received attachments, cached by ciphertext hash, so "open with"
         can hand one to a viewer per-grant. -->
    <files-path name="att" path="att/" />
</paths>
