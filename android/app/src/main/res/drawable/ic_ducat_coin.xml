<!--
  The mark: a ducat.

  The ducat was a gold trade coin that held its weight across borders for six
  centuries and was accepted by people who had never heard of its issuer — which
  is the property this protocol is after, so the mark is the coin rather than a
  metaphor about it.

  Drawn as strokes so it survives being scaled down to a notification badge and
  tinted to a single colour for Android's themed icons. The reeded edge is
  suggested by an inner ring rather than by teeth, which turn to mush below
  about 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Coin edge -->
    <path
        android:strokeColor="#CBA6F7"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:pathData="M54,26 A28,28 0 1,1 53.9,26" />

    <!-- Inner ring: the milled rim of a struck coin -->
    <path
        android:strokeColor="#CBA6F7"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:strokeAlpha="0.55"
        android:pathData="M54,33 A21,21 0 1,1 53.9,33" />

    <!-- D, struck into the face: stem and bowl -->
    <path
        android:strokeColor="#CBA6F7"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M45,42 L45,66" />
    <path
        android:strokeColor="#CBA6F7"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M45,42 L52,42 C61,42 66,47 66,54 C66,61 61,66 52,66 L45,66" />
</vector>
